[Unit]
Description=Rapid Reader first-boot setup (installs packages, then starts the reader)
After=network.target NetworkManager.service
ConditionPathExists=!/var/lib/rapid-reader/.setup-done

[Service]
Type=oneshot
ExecStart=/opt/rapid-reader/setup/firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
